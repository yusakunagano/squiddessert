rules_version = '2';

// ナインゲームのランキング用ルール（ゲームセンター式: 1プレイ1行）。
// - 誰でもランキングを読める
// - 匿名ログインしたブラウザは、自分の uid を付けた新しい記録を追加できる
// - 追加した記録は、あとから書き換えも削除もできない
// - 名前は 1〜12 文字、スコアは 1〜100万点
//
// plays/{id}                 … 総合ランキングと週間ランキング（週間は createdAt が直近7日間のものを表示）
// 以下は終了した仕組み。古いページを開いたままの人が登録しても失敗しないように、ルールだけ残している。
// weeks/{週の月曜日}/plays/{id} … 旧・週間ランキング（月曜はじまり）
// players/{uid}              … 旧・日本ランカー（1人1行の合計点）
// days/{日付}/plays/{id}       … 旧・デイリーランキング
service cloud.firestore {
  match /databases/{database}/documents {

    function validPlay() {
      let d = request.resource.data;
      return request.auth != null
        && d.keys().hasOnly(['name', 'score', 'nines', 'level', 'uid', 'createdAt'])
        && d.uid == request.auth.uid
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 12
        && d.score is int && d.score > 0 && d.score <= 1000000
        && d.nines is int && d.level is int
        && d.createdAt == request.time;
    }

    function validPlayer(uid) {
      let d = request.resource.data;
      return request.auth != null && request.auth.uid == uid
        && d.keys().hasOnly(['name', 'uid', 'life', 'days', 'lastDay', 'updatedAt'])
        && d.uid == uid
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 12
        && d.life is int && d.days is map && d.days.size() <= 9
        && d.lastDay is string && d.lastDay.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.updatedAt == request.time;
    }

    match /players/{uid} {
      allow read: if true;
      // 初回は、それまでのプレイの合計から始める（1000万点まで）
      allow create: if validPlayer(uid)
        && request.resource.data.life > 0 && request.resource.data.life <= 10000000;
      // 2回目からは、1回分（100万点まで）を足すだけ
      allow update: if validPlayer(uid)
        && request.resource.data.life > resource.data.life
        && request.resource.data.life - resource.data.life <= 1000000;
    }

    match /plays/{id} {
      allow read: if true;
      allow create: if validPlay();
    }

    match /weeks/{week}/plays/{id} {
      allow read: if true;
      allow create: if week.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && validPlay();
    }

    match /days/{day}/plays/{id} {
      allow read: if true;
      allow create: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && validPlay();
    }

    // センター街ゾンビナイトの最大4人プレイ用の部屋（hub/zombie/）
    // - 部屋番号は4桁。作った人（host）が部屋を作り、参加する人は joins/{自分のuid} に接続情報（offer）を書く
    // - host だけが各参加者に answer（と番号 slot）を書き足せる
    // - ゲームを始めたら host が消す。30分以上前の部屋は、別の人が同じ番号で作り直せる
    function validRoom() {
      let d = request.resource.data;
      return request.auth != null
        && d.keys().hasOnly(['seed', 'host', 'createdAt'])
        && d.host == request.auth.uid
        && d.seed is int
        && d.createdAt == request.time;
    }
    function isRoomHost(code) {
      return request.auth != null
        && get(/databases/$(database)/documents/zombieRooms/$(code)).data.host == request.auth.uid;
    }
    match /zombieRooms/{code} {
      allow read: if request.auth != null;
      allow create: if code.matches('^[0-9]{4}$') && validRoom();
      allow update: if validRoom() && resource.data.createdAt < request.time - duration.value(30, 'm');
      allow delete: if request.auth != null && resource.data.host == request.auth.uid;

      match /joins/{uid} {
        allow read: if request.auth != null && (request.auth.uid == uid || isRoomHost(code));
        allow create: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['offer', 'createdAt'])
          && request.resource.data.offer is string && request.resource.data.offer.size() < 20000
          && request.resource.data.createdAt == request.time;
        allow update: if isRoomHost(code)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer', 'slot'])
          && request.resource.data.answer is string && request.resource.data.answer.size() < 20000;
        allow delete: if request.auth != null && (request.auth.uid == uid || isRoomHost(code));
      }
    }

    // テニスゲームのオンライン（最大4人）の部屋（tennis-game/）
    // - 部屋番号は4桁。作った人（host）が参加枠ぶんの接続情報（offer1〜offer3）を書く
    // - 入る人は、空いている枠に answerN を1回だけ書き足す（同時に入っても同じ枠は取れない）
    // - 試合が始まったら作った人が消す。30分以上前の部屋は、別の人が同じ番号で作り直せる
    function validTennisRoom() {
      let d = request.resource.data;
      return request.auth != null
        && d.keys().hasOnly(['offer1', 'offer2', 'offer3', 'mode', 'host', 'createdAt'])
        && d.host == request.auth.uid
        && d.mode in ['vs', 'coop']
        && d.offer1 is string && d.offer1.size() < 20000
        && (!('offer2' in d) || (d.offer2 is string && d.offer2.size() < 20000))
        && (!('offer3' in d) || (d.offer3 is string && d.offer3.size() < 20000))
        && d.createdAt == request.time;
    }
    function oneNewAnswer() {
      let ks = request.resource.data.diff(resource.data).affectedKeys();
      return (ks.hasOnly(['answer1']) && !('answer1' in resource.data) && request.resource.data.answer1 is string && request.resource.data.answer1.size() < 20000)
        || (ks.hasOnly(['answer2']) && !('answer2' in resource.data) && request.resource.data.answer2 is string && request.resource.data.answer2.size() < 20000)
        || (ks.hasOnly(['answer3']) && !('answer3' in resource.data) && request.resource.data.answer3 is string && request.resource.data.answer3.size() < 20000);
    }
    match /tennisRooms/{code} {
      allow read: if request.auth != null;
      allow create: if code.matches('^[0-9]{4}$') && validTennisRoom();
      allow update: if request.auth != null && (
        (validTennisRoom() && resource.data.createdAt < request.time - duration.value(30, 'm'))
        || oneNewAnswer()
      );
      allow delete: if request.auth != null && resource.data.host == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
