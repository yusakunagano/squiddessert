rules_version = '2';

// ナインゲームのランキング用ルール（ゲームセンター式: 1プレイ1行）。
// - 誰でもランキングを読める
// - 匿名ログインしたブラウザは、自分の uid を付けた新しい記録を追加できる
// - 追加した記録は、あとから書き換えも削除もできない
// - 名前は 1〜12 文字、スコアは 1〜100万点
//
// plays/{id}                 … 総合ランキング
// weeks/{週の月曜日}/plays/{id} … 週間ランキング（例: weeks/2026-10-05/plays/xxxx）
// days/{日付}/plays/{id}       … デイリーランキング（例: days/2026-10-09/plays/xxxx）
service cloud.firestore {
  match /databases/{database}/documents {

    function validPlay() {
      let d = request.resource.data;
      return request.auth != null
        && d.keys().hasOnly(['name', 'score', 'nines', 'level', 'uid', 'createdAt'])
        && d.uid == request.auth.uid
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 12
        && d.score is int && d.score > 0 && d.score <= 1000000
        && d.nines is int && d.level is int
        && d.createdAt == request.time;
    }

    match /plays/{id} {
      allow read: if true;
      allow create: if validPlay();
    }

    match /weeks/{week}/plays/{id} {
      allow read: if true;
      allow create: if week.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && validPlay();
    }

    match /days/{day}/plays/{id} {
      allow read: if true;
      allow create: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && validPlay();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
